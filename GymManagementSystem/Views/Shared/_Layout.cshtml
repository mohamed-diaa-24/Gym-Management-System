<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - GymManagementSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/GymManagementSystem.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3">
        <a class="navbar-brand" asp-controller="Classes" asp-action="Index">Gym Management</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Classes" asp-action="Index">Classes</a></li>

                @if (Context.Session.GetString("IsAdmin") == "True")
                {
                <li class="nav-item"><a class="nav-link" asp-controller="Trainers" asp-action="Index">Manage Trainers</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="GymClasses" asp-action="Index">Manage Classes</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Members" asp-action="Index">Manage Members</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Enrollments" asp-action="Create">Enroll Member</a></li>
                }
            </ul>
            <span class="navbar-text text-white me-3">@Context.Session.GetString("UserName")</span>
            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Logout">Logout</a>
        </div>
    </nav>
</header>
<div class="container mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @RenderBody()
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - GymManagementSystem - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>