@model GymManagementSystem.Models.GymClass
@{ ViewData["Title"] = "Edit Class"; }

<h3>Edit Class</h3>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Schedule" class="form-label"></label>
        <input asp-for="Schedule" class="form-control" />
        <span asp-validation-for="Schedule" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TrainerId" class="form-label">Trainer</label>
        <select asp-for="TrainerId" class="form-select" asp-items="@(new SelectList(ViewBag.Trainers, "Id", "Name"))">
            <option value="">-- Select Trainer --</option>
        </select>
        <span asp-validation-for="TrainerId" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }