@model IEnumerable<GymManagementSystem.Models.GymClass>

<div class="row">
    @if (!Model.Any())
    {
        <p>No classes found.</p>
    }
    @foreach (var c in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@c.Name</h5>
                    <p class="card-text">@c.Description</p>
                    <p class="mb-1"><strong>Schedule:</strong> @c.Schedule</p>
                    <p class="mb-2"><strong>Trainer:</strong> @c.Trainer?.Name</p>
                    <a asp-controller="Classes" asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-primary">Details</a>
                </div>
            </div>
        </div>
    }
</div>