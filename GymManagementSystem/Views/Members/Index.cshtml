@model GymManagementSystem.ViewModels.PaginatedList<GymManagementSystem.Models.Member>
@{ ViewData["Title"] = "Manage Members"; }

<h3>Members</h3>
<a asp-action="Create" class="btn btn-primary mb-3">Add Member</a>

<table class="table table-bordered">
    <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var m in Model)
    {
        <tr>
            <td>@m.Name</td>
            <td>@m.Email</td>
            <td>@m.Phone</td>
            <td>
                <a asp-action="Details" asp-route-id="@m.Id" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-warning">Edit</a>
                <button type="button" class="btn btn-sm btn-danger btn-delete" data-id="@m.Id">Delete</button>
            </td>
        </tr>
    }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageIndex="@i">@i</a>
            </li>
        }
    </ul>
</nav>

@section Scripts {
    <script>
    $('.btn-delete').on('click', function () {
        var id = $(this).data('id');
        Swal.fire({
            title: 'Are you sure?',
            text: 'This member will be deleted permanently.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, delete it'
        }).then((result) => {
            if (result.isConfirmed) {
                var form = $('<form method="post" action="/Members/Delete/' + id + '"></form>');
                form.append('@Html.AntiForgeryToken()');
                $('body').append(form);
                form.submit();
            }
        });
    });
</script>
}