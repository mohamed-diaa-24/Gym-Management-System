@model GymManagementSystem.ViewModels.ClassesIndexViewModel
@{ ViewData["Title"] = "Classes"; }

<h3>Gym Classes</h3>

<div class="row mb-3">
    <div class="col-md-4">
        <select id="trainerFilter" class="form-select">
            <option value="">All Trainers</option>
            @foreach (var t in Model.Trainers)
            {
                <option value="@t.Id" selected="@(Model.SelectedTrainerId == t.Id)">@t.Name</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <input id="searchBox" class="form-control" placeholder="Search by class name" value="@Model.SearchTerm" />
    </div>
</div>

<div id="classesContainer">
    <partial name="_ClassesPartial" model="Model.Classes" />
</div>

@section Scripts {
    <script>
    function loadClasses() {
        var trainerId = $('#trainerFilter').val();
        var search = $('#searchBox').val();
        $.get('/Classes/FilterByTrainer', { trainerId: trainerId, search: search }, function (data) {
            $('#classesContainer').html(data);
        });
    }
    $('#trainerFilter').on('change', loadClasses);
    $('#searchBox').on('keyup', loadClasses);
</script>
}